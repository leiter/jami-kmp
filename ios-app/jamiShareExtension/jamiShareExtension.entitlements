<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The share inbox (I8). Simulator-only until the App Group exists in the developer
	     portal; see ios-app/jamiShareExtension/README.md. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.net.jami.kmp</string>
	</array>
</dict>
</plist>
