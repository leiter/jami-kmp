-- Durable outbox (doc/plan_daemon_stability_sync.md, Phase 4 / finding F4).
-- Messages the user sent into a conversation that could not take them yet — a swarm still
-- bootstrapping, or a 1:1 whose peer has not joined (libjami drops a message committed while the
-- swarm has no peer device). They were never handed to the daemon; SendQueueService sends and
-- deletes them once the conversation goes live, including after an app restart.

CREATE TABLE outbox_message (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    account_id TEXT NOT NULL,
    conversation_id TEXT NOT NULL,
    body TEXT NOT NULL,
    reply_to TEXT,
    created_at INTEGER NOT NULL
);

CREATE INDEX outbox_conversation_idx ON outbox_message(account_id, conversation_id);

insert:
INSERT INTO outbox_message(account_id, conversation_id, body, reply_to, created_at)
VALUES (?, ?, ?, ?, ?);

lastInsertId:
SELECT last_insert_rowid();

selectAll:
SELECT * FROM outbox_message ORDER BY id;

selectByConversation:
SELECT * FROM outbox_message
WHERE account_id = ? AND conversation_id = ?
ORDER BY id;

deleteById:
DELETE FROM outbox_message WHERE id = ?;
